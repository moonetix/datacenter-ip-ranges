{
  "name": "datacenter-ip-ranges",
  "version": "1.3.0",
  "description": "Daily cloud, hosting, CDN, Tor, iCloud Private Relay and search/AI crawler IP ranges from the providers' own feeds, with lookup and crawler verification helpers for Node.js, PHP and Python.",
  "license": "MIT",
  "author": "Moonetix (https://moonetix.com)",
  "homepage": "https://moonetix.github.io/datacenter-ip-ranges/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonetix/datacenter-ip-ranges.git"
  },
  "bugs": {
    "url": "https://github.com/moonetix/datacenter-ip-ranges/issues"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./matcher": "./src/matcher.js",
    "./ip": "./src/ip.js",
    "./bots": "./src/bots.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "datacenter-ip": "bin/check.js"
  },
  "files": [
    "src/",
    "bin/",
    "php/DatacenterIp.php",
    "data/"
  ],
  "scripts": {
    "test": "node --test",
    "update": "node scripts/update.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "datacenter",
    "ip-ranges",
    "cidr",
    "cloud",
    "aws",
    "cloudflare",
    "tor",
    "icloud-private-relay",
    "bot-detection",
    "crawler",
    "googlebot",
    "gptbot",
    "verify-bot",
    "fraud-detection",
    "firewall",
    "nftables",
    "ipset",
    "nginx"
  ]
}
